# ═══════════════════════════════════════════════════════════════════
# CLÉSS production орчин. Хуулах: cp .env.production.example .env.production
# Энэ файл git-д ОРОХГҮЙ (.gitignore: .env*). Эрх: chmod 600 .env.production
# ═══════════════════════════════════════════════════════════════════

# ─── Compose ───
# localdb — compose доторх postgres:16 (порт гадагш нээгдэхгүй). Гадны DB ашиглах бол хоосон болго.
COMPOSE_PROFILES=localdb
# Домэйн (https:// ба www-гүй). Caddy үүгээр Let's Encrypt гэрчилгээ авна, www → энэ рүү redirect.
# Локал туршилт: localhost
SITE_DOMAIN=cless.mn
# Цаг (backup, worker, лог)
TZ=Asia/Ulaanbaatar

# ─── Локал Postgres (COMPOSE_PROFILES=localdb үед) ───
POSTGRES_USER=cless
# Үүсгэх: openssl rand -hex 24   (URL-д тусгай тэмдэгт оруулахгүйн тулд hex)
POSTGRES_PASSWORD=
POSTGRES_DB=cless

# ─── DB холболт ───
# localdb: postgresql://cless:<POSTGRES_PASSWORD>@db:5432/cless
# Гадны DB (Supabase): Transaction pooler (6543, ?pgbouncer=true)
DATABASE_URL=postgresql://cless:CHANGE_ME@db:5432/cless
# Migration, backup-д шууд холболт (pooler биш). localdb үед DATABASE_URL-тэй ижил.
DIRECT_URL=postgresql://cless:CHANGE_ME@db:5432/cless
# App image BUILD (prerender)-д: build нь host сүлжээгээр явдаг тул localdb үед 127.0.0.1 (db-ийн publish порт).
# Гадны DB (Supabase) үед DATABASE_URL-тэй ижил. BuildKit secret-ээр дамжина — image-д үлдэхгүй.
BUILD_DATABASE_URL=postgresql://cless:CHANGE_ME@127.0.0.1:5432/cless
# db-ийн 127.0.0.1 дээрх порт (өөр Postgres 5432-ийг эзэлсэн бол солино, BUILD_DATABASE_URL-ийг мөн)
DB_HOST_PORT=5432

# ─── Auth.js ───
# Үүсгэх: openssl rand -base64 32
AUTH_SECRET=
# Сайтын бүрэн хаяг (callback, cookie)
AUTH_URL=https://cless.mn

# ─── Сайт ───
# Canonical, sitemap, og:image. Төгсгөлийн "/"-гүй. BUILD үед image-д шингэдэг — солибол дахин build.
NEXT_PUBLIC_SITE_URL=https://cless.mn

# ─── QPay Merchant API v2 (заавал биш) ───
# Бүгд бөглөгдөж, админы тохиргоо qpay.mode = "api" үед л API горим. Үгүй бол "гараар" горим.
# Production: https://merchant.qpay.mn · Sandbox: https://merchant-sandbox.qpay.mn
QPAY_BASE_URL=
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# QPay-ээс тодруулах (байхгүй бол "terminal")
QPAY_INVOICE_RECEIVER_CODE=
# Callback URL-ийн HMAC түлхүүр. Үүсгэх: openssl rand -hex 32
QPAY_CALLBACK_SECRET=

# ─── Имэйл (Resend) ───
# Байхгүй бол имэйл илгээгдэхгүй (.emails/ volume руу HTML файл болж бичигдэнэ).
RESEND_API_KEY=
# Resend-д баталгаажсан домэйнээс: "CLÉSS <no-reply@cless.mn>"
EMAIL_FROM=

# ─── Backup ───
# Серверийн локал хуулбар: ./backups/, BACKUP_KEEP_DAYS хоног.
# Хуваарь: container дотор өдөр бүр BACKUP_AT. systemd timer ашиглавал (deploy/README.md §9.2) "off".
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14

# ─── Backup: серверээс ГАДАГШ (ЗААВАЛ — VPS устахад локал backup хамт устана) ───
# Бүртгэлийг үйлчлүүлэгчийн нэр дээр нээнэ. Хоосон бол гадагш хуулахгүй (лог-д анхааруулна).
#   s3: Cloudflare R2, Wasabi, AWS S3, MinIO …   b2: Backblaze B2
BACKUP_REMOTE=
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_PREFIX=cless
# s3 үед
#   R2: https://<account_id>.r2.cloudflarestorage.com, region auto, provider Cloudflare
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
# b2 үед (Application Key — зөвхөн тухайн bucket-д эрхтэй key үүсгэнэ)
BACKUP_B2_ACCOUNT_ID=
BACKUP_B2_APPLICATION_KEY=
# Шифрлэлт (зөвлөж байна). АЛДВАЛ backup-ийг сэргээх боломжгүй — нууц үгийн менежерт хадгална.
# Үүсгэх: openssl rand -base64 32
BACKUP_ENCRYPT_PASSWORD=
# Хадгалах хугацаа (гадаад): өдөр бүрийнх N хоног, долоо хоног бүрийнх (BACKUP_WEEKLY_DOW, 7=Ням) N долоо хоног
BACKUP_REMOTE_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_WEEKS=8
BACKUP_WEEKLY_DOW=7

# ─── Image tag (deploy/update.sh удирдана) ───
IMAGE_TAG=latest
