// Biologique Recherche Mongolia — бүх модулийн schema.
//
// Зарчмууд:
// - Мөнгө бүгд Int (төгрөг, бутархайгүй).
// - SaleItem нь нэр, үнэ, өртөгийг SNAPSHOT болгон хадгална.
// - Variant.stock нь StockMovement-уудын нийлбэрийн КЭШ. Зөвхөн transaction
//   дотор movement-тэй хамт өөрчлөгдөнө. Wallet.balance мөн адил (WalletTxn).
// - Appointment давхцлыг DB түвшинд EXCLUDE constraint хамгаална (migration-ыг үз).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN
  MANAGER
  STAFF
  /// Нягтлан: менежерийн хэсгийг зөвхөн харна + цалингийн модулийг бүрэн удирдана
  ACCOUNTANT
}

enum CollectionKind {
  CATEGORY
  CONCERN
}

enum BadgeType {
  NEW
  ICONIC
  LIMITED
  ONLINE_EXCLUSIVE
}

enum ProductKind {
  SINGLE
  BUNDLE
}

enum RelationType {
  /// "Хамт хэрэглэх арчилгаа" — арчилгааны алхмын дарааллаар
  PROTOCOL
  /// "Танд таалагдаж магадгүй"
  SIMILAR
  /// "Төгс хослол" — санал болгох багц
  BUNDLE_SUGGESTION
}

enum ItemKind {
  SERVICE
  PRODUCT
}

enum SaleChannel {
  POS
  ONLINE
}

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

/// eBarimt (12-р сараас)
enum ReceiptStatus {
  NOT_ISSUED
  PENDING
  ISSUED
  FAILED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PACKED
  SHIPPED
  DELIVERED
  PICKED_UP
}

enum PayMethod {
  QPAY
  CARD
  CASH
  TRANSFER
  GIFT_CARD
  MEMBERSHIP
}

enum PayStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMoveType {
  SALE
  REFUND
  PAY_IN
  PAY_OUT
}

enum EmailStatus {
  NOT_SENT
  QUEUED
  SENT
  FAILED
}

enum SkinType {
  DRY
  OILY
  COMBINATION
  NORMAL
  SENSITIVE
}

enum ApptStatus {
  /// Онлайн захиалга — ресепшн батлахыг хүлээж буй (цагийг түр барина)
  PENDING
  BOOKED
  CONFIRMED
  /// Ирсэн (POS ноорог нээгдсэн)
  ARRIVED
  IN_PROGRESS
  DONE
  CANCELLED
  NO_SHOW
}

/// Цаг хаанаас бүртгэгдсэн
enum ApptSource {
  PHONE
  INSTAGRAM
  FACEBOOK
  WALK_IN
  OTHER
  /// Сайтаар үйлчлүүлэгч өөрөө захиалсан
  ONLINE
}

/// Ажилтны бүртгэлийн төлөв: урьсан (код хүлээж буй) → идэвхтэй
enum UserStatus {
  INVITED
  ACTIVE
}

/// Үйлчлүүлэгч хаанаас бүртгэгдсэн
enum CustomerOrigin {
  ADMIN
  ONLINE
}

/// Нэг удаагийн кодын зорилго
enum VerifyPurpose {
  STAFF_INVITE
  STAFF_RESET
  STAFF_PHONE
  CUSTOMER_LOGIN
  CUSTOMER_EMAIL
}

enum VerifyStatus {
  PENDING
  APPROVED
  EXPIRED
  CANCELED
}

enum MessageChannel {
  SMS
  EMAIL
  VERIFY
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

enum TimeOffReason {
  VACATION
  SICK
  TRAINING
  OTHER
}

enum StockMoveType {
  PURCHASE
  SALE
  SERVICE_USE
  RETURN
  ADJUSTMENT
}

enum CommissionType {
  PERCENT
  FIXED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

/// ADVANCE — сарын эхний хагасын урьдчилгаа; FINAL — сарын эцсийн тооцоо (бүтэн сараар суутгал, урьдчилгаа хасна);
/// FULL — хагас тус бүрийг бие даан (суутгалтай)
enum PayrollKind {
  ADVANCE
  FINAL
  FULL
}

/// Ирц: менежер тэмдэглэнэ. Тэмдэглээгүй өдөр — ажлын хуваариас (WORKED / OFF) тооцоолно.
enum WorkDayStatus {
  WORKED
  HALF_DAY
  /// Цалинтай чөлөө — ажилласанд тооцно
  PAID_LEAVE
  UNPAID_LEAVE
  SICK
  /// Тасалсан
  ABSENT
  /// Амралт
  OFF
}

enum PayrollAdjustmentType {
  ADDITION
  DEDUCTION
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  /// Илгээхгүйгээр алгассан (PROMPT 22: хэт хуучирсан SMS/сануулга — бодит хүнд хожуу очихоос сэргийлнэ)
  SKIPPED
}

enum JobType {
  EBARIMT
  EMAIL
  SMS
  VISIT_EMAIL
  QPAY_CANCEL_INVOICE
  /// Цаг үүссэн / өөрчлөгдсөн / цуцлагдсан тухай имэйл
  APPT_EMAIL
  /// Эхлэхээс 24 цагийн өмнөх сануулга
  APPT_REMINDER
  /// Сайтаас ирсэн нөөцлүүлэх хүсэлт → ресепшнд имэйл
  INQUIRY_EMAIL
  /// Өдрийн тайлан → нягтлан (Excel хавсралттай)
  ACCOUNTANT_REPORT
  /// PROMPT 27: багцын хугацаа дуусахаас 7 хоногийн өмнө SMS
  PACKAGE_EXPIRY
}

enum DispatchStatus {
  PENDING
  SENT
  FAILED
}

/// Сайтын "Салонд захиалах" → нөөцлүүлэх хүсэлтийн төлөв
enum InquiryStatus {
  NEW
  CONTACTED
  DONE
  CANCELLED
}

enum EbarimtType {
  B2C_RECEIPT
  B2B_RECEIPT
  B2C_INVOICE
  B2B_INVOICE
}

// ──────────────────────── Хэрэглэгч ба эрх ────────────────────────

model User {
  id                 String     @id @default(cuid())
  name               String
  /// Сонголтоор (PROMPT 15): утас заавал, имэйл байхгүй байж болно
  email              String?    @unique
  phone              String?
  /// Нэвтрэх утас — 8 оронтой, хэвийн болгосон (normalizePhone)
  loginPhone         String?    @unique
  status             UserStatus @default(ACTIVE)
  invitedAt          DateTime?
  invitedById        String?
  inviteExpiresAt    DateTime?
  activatedAt        DateTime?
  passwordHash       String
  role               Role       @default(STAFF)
  isActive           Boolean    @default(true)
  /// Календарьт үйлчилгээ хийх ажилтнаар сонгогдох эсэх
  isBookable         Boolean    @default(false)
  /// ADMIN түр нууц үг өгсөн — анх нэвтрэхэд солихыг шаардана
  mustChangePassword Boolean    @default(false)
  /// Нууц үг солигдсон мөч — үүнээс өмнө олгосон session хүчингүй
  passwordChangedAt  DateTime?
  baseSalary         Int        @default(0)
  /// Ажил олгогчийн НДШ-ийн ангилал (PayrollRateSet.employerRates[].code); null = эхний ангилал
  siCategory         String?
  /// Банкны данс — AES-256-GCM шифрлэгдсэн (src/server/crypto/field.ts). Зөвхөн ADMIN / ACCOUNTANT уншина.
  bankAccountEnc     String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  staffAppointments     Appointment[]       @relation("ApptStaff")
  createdAppointments   Appointment[]       @relation("ApptCreatedBy")
  cancelledAppointments Appointment[]       @relation("ApptCancelledBy")
  customerNotes         CustomerNote[]      @relation("CustomerNoteAuthor")
  visitPhotos           VisitPhoto[]        @relation("VisitPhotoCreatedBy")
  reportDispatches      ReportDispatch[]    @relation("ReportDispatchSentBy")
  conductedVisits       Visit[]
  createdSales          Sale[]              @relation("SaleCreatedBy")
  closedSales           Sale[]              @relation("SaleClosedBy")
  discountApprovals     Sale[]              @relation("SaleDiscountApprovedBy")
  saleItems             SaleItem[]
  createdPayments       Payment[]           @relation("PaymentCreatedBy")
  confirmedPayments     Payment[]           @relation("PaymentConfirmedBy")
  cashMovements         CashMovement[]
  requestedRefunds      Refund[]            @relation("RefundRequestedBy")
  approvedRefunds       Refund[]            @relation("RefundApprovedBy")
  priceChanges          PriceHistory[]
  stockMovements        StockMovement[]
  openedShifts          CashShift[]         @relation("ShiftOpenedBy")
  closedShifts          CashShift[]         @relation("ShiftClosedBy")
  commissionRules       CommissionRule[]
  payrollLines          PayrollLine[]
  auditLogs             AuditLog[]
  schedules             StaffSchedule[]     @relation("StaffSchedules")
  timeOffs              StaffTimeOff[]      @relation("StaffTimeOffs")
  createdTimeOffs       StaffTimeOff[]      @relation("TimeOffCreatedBy")
  services              ServiceStaff[]      @relation("ServiceStaff")
  handledInquiries      ProductInquiry[]    @relation("InquiryHandledBy")
  soldItems             SaleItem[]          @relation("SaleItemSeller")
  workDays              WorkDay[]           @relation("WorkDayStaff")
  markedWorkDays        WorkDay[]           @relation("WorkDayMarkedBy")
  salaryHistory         SalaryHistory[]     @relation("SalaryHistoryStaff")
  payrollAdjustments    PayrollAdjustment[] @relation("PayrollAdjustmentStaff")
  expensesCreated       Expense[]           @relation("ExpenseCreatedBy")
  attendanceEvents      AttendanceEvent[]   @relation("AttendanceEventStaff")
  attendanceCreated     AttendanceEvent[]   @relation("AttendanceEventCreatedBy")
  attendanceNotes       AttendanceNote[]    @relation("AttendanceNoteStaff")
  attendanceNotesBy     AttendanceNote[]    @relation("AttendanceNoteBy")
  serviceStockUses      StockMovement[]     @relation("StockMovementStaff")
  approvedPayrolls      PayrollPeriod[]     @relation("PayrollApprovedBy")
  confirmedRateSets     PayrollRateSet[]    @relation("RateSetConfirmedBy")

  packageRedemptionsAsStaff PackageRedemption[] @relation("PackageRedemptionStaff")

  @@index([role, isActive])
}

// ─────────────────────────── Каталог ───────────────────────────

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  /// Брэндийн нэр — орчуулагдахгүй (MASQUE VIVANT)
  name           String
  kind           ProductKind @default(SINGLE)
  /// "Арьсыг тэнцвэржүүлэх нүүрний маск"
  tagline        String?
  /// "Тос ихтэй, батга гарах хандлагатай арьсанд тохиромжтой."
  recommendedFor String?
  /// Ашиг тус: ["Тайвшруулах", "Нүх сүв нарийсгах"]
  benefits       String[]    @default([])
  description    String
  skinScience    String?
  /// Хэрэглэх заавар — мөр бүр нэг алхам
  howToUse       String[]    @default([])
  /// INCI — латинаар, орчуулахгүй
  ingredients    String?
  /// Байгаль орчны мэдээлэл: { "Савлагаа": "Шилэн сав" }
  environmental  Json?
  clinicalNotes  String[]    @default([])
  seoTitle       String?
  seoDescription String?
  badge          BadgeType?
  isPublished    Boolean     @default(false)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  images          ProductImage[]
  variants        Variant[]
  collections     ProductCollection[]
  commissionRules CommissionRule[]
  relations       ProductRelation[]   @relation("RelationFrom")
  relatedFrom     ProductRelation[]   @relation("RelationTo")
  bundleItems     BundleItem[]

  @@index([isPublished, sortOrder])
  @@index([badge])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Variant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique
  /// Баркод (EAN/UPC эсвэл дотоод код) — POS-ийн баркод уншигч
  barcode    String?  @unique
  /// Smart Logic-ийн барааны код (интеграц — дараагийн шат)
  slItemId   String?
  size       String
  price      Int
  costPrice  Int      @default(0)
  /// КЭШ: sum(StockMovement.qty). Зөвхөн movement-тэй нэг transaction-д өөрчил.
  stock      Int      @default(0)
  /// Төлбөр хүлээж буй онлайн захиалгад түр барьсан тоо.
  reserved   Int      @default(0)
  lowStockAt Int      @default(3)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceHistory    PriceHistory[]
  stockMovements  StockMovement[]
  consumedBy      ServiceConsumable[]
  saleItems       SaleItem[]
  recommendations VisitRecommendation[]
  inBundles       BundleItem[]

  @@index([productId, sortOrder])
}

model ProductRelation {
  id        String       @id @default(cuid())
  productId String
  relatedId String
  type      RelationType
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  product Product @relation("RelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelationTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, type])
  @@index([productId, type, position])
}

/// Багцын бүрэлдэхүүн. Багц (kind=BUNDLE) өөрийн Variant-аар зарагдана;
/// бүрэлдэхүүний аль нэг нь дууссан бол багц дууссан.
model BundleItem {
  id              String   @id @default(cuid())
  bundleProductId String
  variantId       String
  qty             Int      @default(1)
  position        Int      @default(0)
  createdAt       DateTime @default(now())

  bundle  Product @relation(fields: [bundleProductId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([bundleProductId, variantId])
  @@index([variantId])
}

model PriceHistory {
  id          String   @id @default(cuid())
  variantId   String
  oldPrice    Int
  newPrice    Int
  oldCost     Int
  newCost     Int
  changedById String?
  createdAt   DateTime @default(now())

  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}

model StockMovement {
  id            String        @id @default(cuid())
  /// TODO(multi-branch): үлдэгдлийг StockBalance(branchId, variantId) руу шилжүүлэхэд ашиглана
  branchId      String
  variantId     String
  type          StockMoveType
  /// +орлого / -зарлага
  qty           Int
  unitCost      Int?
  saleId        String?
  note          String?
  createdById   String?
  /// PROMPT 27: үйлчилгээнд олгосон (SERVICE_USE) — аль цаг, үйлчилгээ, гоо сайханч
  appointmentId String?
  serviceId     String?
  staffId       String?
  createdAt     DateTime      @default(now())

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  variant     Variant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sale        Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staff       User?        @relation("StockMovementStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([branchId, createdAt])
  @@index([variantId, createdAt])
  @@index([saleId])
  @@index([type, createdAt])
  @@index([appointmentId])
}

model Collection {
  id          String         @id @default(cuid())
  slug        String         @unique
  /// Цэс, tile-д харагдах нэр: "Пигментаци ба толбо"
  name        String
  kind        CollectionKind
  /// Шаталсан ангилал (Нүүрний арчилгаа › Серум › Хөгшрөлтийн эсрэг)
  parentId    String?
  /// Хуудасны H1 (байхгүй бол name): "ПИГМЕНТАЦИЙН ПРОТОКОЛ"
  heading     String?
  /// Баннерын доорх товч танилцуулга
  intro       String?
  /// Хуудасны доод SEO догол мөр
  seoText     String?
  bannerImage String?
  /// Нүүр хуудас / ангиллын tile зураг
  tileImage   String?
  showInMenu  Boolean        @default(true)
  sortOrder   Int            @default(0)
  showOnHome  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent          Collection?         @relation("CollectionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Collection[]        @relation("CollectionTree")
  products        ProductCollection[]
  tiles           CollectionTile[]
  commissionRules CommissionRule[]

  @@index([kind, sortOrder])
  @@index([parentId, sortOrder])
}

model ProductCollection {
  productId    String
  collectionId String
  /// Ангилал бүрт тусдаа дараалал (CONCERN-д арчилгааны алхам)
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

/// Ангиллын grid-д бүтээгдэхүүний дунд орох редакцийн нүд
model CollectionTile {
  id           String   @id @default(cuid())
  collectionId String
  /// Grid дахь нүдний дугаар (1-ээс)
  position     Int
  image        String
  eyebrow      String?
  title        String
  text         String?
  ctaLabel     String?
  ctaHref      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, position])
}

// ─────────────────────────── Үйлчилгээ ───────────────────────────

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String
  durationMin      Int
  /// Цэвэрлэгээ/бэлтгэлийн хугацаа — дараагийн цаг эхлэх хүртэл
  bufferMin        Int      @default(0)
  requiresRoom     Boolean  @default(false)
  /// Smart Logic-ийн үйлчилгээний код (интеграц — дараагийн шат)
  slItemId         String?
  /// Цагийн календарьт захиалж болох эсэх
  bookable         Boolean  @default(true)
  /// Сайтад харагдах эсэх (дотоод үйлчилгээ = false)
  isPublic         Boolean  @default(true)
  /// Сайтын ангилал (бүлэглэхэд): "Нүүрний эмчилгээ", "Оношлогоо" …
  category         String?
  /// Картанд харагдах товч тайлбар
  shortDescription String?
  /// Хэнд тохиромжтой
  suitableFor      String?
  /// Үр дүн
  results          String?
  /// Үнийг "…₮-өөс" гэж харуулах (хувилбар/нэмэлтээс хамааран өсөх)
  priceFrom        Boolean  @default(false)
  price            Int
  costNote         String?
  image            String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consumables     ServiceConsumable[]
  appointments    Appointment[]
  saleItems       SaleItem[]
  commissionRules CommissionRule[]
  staff           ServiceStaff[]
  stockUses       StockMovement[]

  packageTemplates   PackageTemplateService[]
  packageRedemptions PackageRedemption[]

  @@index([isActive, sortOrder])
}

model ServiceConsumable {
  id            String   @id @default(cuid())
  serviceId     String
  variantId     String
  /// 1 үйлчилгээнд зарцуулагдах савны хэсэг. 0.1 = 1 савны 10%.
  qtyPerService Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([serviceId, variantId])
}

// ─────────────────────── Үйлчлүүлэгч, цаг, айлчлал ───────────────────────

model Customer {
  id                 String         @id @default(cuid())
  name               String
  phone              String         @unique
  email              String?
  birthday           DateTime?      @db.Date
  skinType           SkinType?
  notes              String?
  /// Маркетингийн имэйл (айлчлалын үйлчилгээний имэйлд хамаарахгүй)
  marketingConsent   Boolean        @default(false)
  /// Өмнө/дараах зураг авахыг зөвшөөрсөн огноо (A9) — null бол зураг авахгүй
  photoConsentAt     DateTime?
  /// PROMPT 15: сайтаар бүртгүүлсэн эсэх, нэвтрэлт, зөвшөөрөл
  registeredVia      CustomerOrigin @default(ADMIN)
  onlineRegisteredAt DateTime?
  lastLoginAt        DateTime?
  /// Хувийн мэдээлэл ашиглах зөвшөөрөл (сайтаар бүртгүүлэхэд)
  dataConsentAt      DateTime?
  /// Айлчлалын тайланг имэйлээр хүлээн авахыг зөвшөөрсөн
  emailConsentAt     DateTime?
  emailVerifiedAt    DateTime?
  /// Ирээгүй 2+ → онлайн захиалга хаагдана; менежер нээхэд энэ огнооноос хойших ирээгүйг л тоолно
  onlineUnblockedAt  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  appointments Appointment[]
  visits       Visit[]
  sales        Sale[]
  giftCards    GiftCard[]
  wallet       Wallet?
  packages     CustomerPackage[]
  notesLog     CustomerNote[]
  photos       VisitPhoto[]
  sessions     CustomerSession[]
  emails       CustomerEmail[]

  @@index([email])
  @@index([name])
}

/// Давхцал хориглох constraint migration-д гараар нэмэгдсэн:
/// EXCLUDE USING gist ("staffId" WITH =, tstzrange("startsAt","endsAt") WITH &&)
/// WHERE (status NOT IN ('CANCELLED','NO_SHOW'))
/// Цаг захиалга. Давхцлыг DB-ийн EXCLUDE constraint хориглоно (migration-д гараар):
///   staff: EXCLUDE USING gist ("staffId" WITH =, tstzrange("startsAt","blockedUntil") WITH &&)
///   room:  мөн адил "roomId"-аар (roomId NULL үед хамаарахгүй)
///   WHERE status NOT IN ('CANCELLED','NO_SHOW')
/// POS-тэй холбоо: Sale.appointmentId (идэвхтэй нэг л Sale — partial unique index), Visit.appointmentId.
model Appointment {
  id                String     @id @default(cuid())
  branchId          String
  customerId        String
  /// Үйлчилгээ хийх хүн (STAFF/MANAGER/ADMIN — isBookable)
  staffId           String
  serviceId         String
  roomId            String?
  startsAt          DateTime   @db.Timestamptz(3)
  /// startsAt + service.durationMin (buffer ОРОХГҮЙ)
  endsAt            DateTime   @db.Timestamptz(3)
  /// endsAt + service.bufferMin + extraMin — давхцлын constraint үүн дээр
  blockedUntil      DateTime   @db.Timestamptz(3)
  /// "Нэмэлт цаг": өрөө бэлдэх, цэвэрлэх (0 / 10 / 15 / 30 мин) — buffer-ээс гадна
  extraMin          Int        @default(0)
  status            ApptStatus @default(BOOKED)
  /// PROMPT 27: энэ цагт ашиглах багц (менежер сонгоно) — «Орсон» болоход 1 удаа хасагдана
  customerPackageId String?
  source            ApptSource @default(PHONE)
  note              String?
  cancelReason      String?
  /// Цуцалсан ангилал (CANCEL_CATEGORIES — appointments/cancel.ts); cancelReason нь тайлбар
  cancelCategory    String?
  /// Хэн, хэзээ цуцалсан
  cancelledById     String?
  cancelledAt       DateTime?  @db.Timestamptz(3)
  /// Захиалах үеийн үнэ (мэдээлэл) — POS дээр үнэ дахин тооцогдоно
  priceSnapshot     Int        @default(0)
  createdById       String?
  version           Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff       User            @relation("ApptStaff", fields: [staffId], references: [id], onDelete: Restrict)
  service     Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  room        Room?           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy   User?           @relation("ApptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User?           @relation("ApptCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  visit       Visit?
  sales       Sale[]
  photos      VisitPhoto[]
  stockUses   StockMovement[]

  customerPackage   CustomerPackage?   @relation(fields: [customerPackageId], references: [id], onDelete: SetNull)
  packageRedemption PackageRedemption?

  @@index([branchId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId, startsAt])
  @@index([startsAt])
  @@index([cancelledAt])
}

/// Эмчилгээний өрөө. Идэвхтэй өрөө 0 бол өрөөний логик бүхэлдээ унтарна.
model Room {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([branchId, isActive, sortOrder])
}

/// Ажилтны 7 хоногийн ажлын цаг. Нэг өдөрт хэд хэдэн интервал (завсарлага).
/// weekday: 0 = Ням … 6 = Бямба (УБ цагаар); startTime/endTime "HH:MM" (УБ).
model StaffSchedule {
  id        String   @id @default(cuid())
  staffId   String
  weekday   Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  staff User @relation("StaffSchedules", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

/// Амралт / чөлөө (UTC)
model StaffTimeOff {
  id          String        @id @default(cuid())
  staffId     String
  startsAt    DateTime      @db.Timestamptz(3)
  endsAt      DateTime      @db.Timestamptz(3)
  reason      TimeOffReason
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  staff     User  @relation("StaffTimeOffs", fields: [staffId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TimeOffCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([staffId, startsAt])
}

/// Хэн ямар үйлчилгээ хийж чадах. Үйлчилгээнд мөр байхгүй бол бүх bookable ажилтан.
model ServiceStaff {
  serviceId String
  staffId   String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff   User    @relation("ServiceStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
  @@index([staffId])
}

/// Үйлчлүүлэгчийн тэмдэглэл (A8): гоо сайханч, менежер бичнэ — "Үйлчлүүлэгч ингэж хэлсэн", мэдрэг
/// байдал, дуртай/дургүй зүйл. Зохиогч 24 цагийн дотор засна/устгана; ADMIN, MANAGER бүгдийг.
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  visitId    String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  visit    Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
}

enum PhotoKind {
  BEFORE
  AFTER
}

/// Айлчлалын өмнө/дараах зураг (A9). Файл нь public/-д БИШ — хувийн хавтас (STORAGE_PRIVATE_DIR),
/// зөвхөн /api/media/visit/[id]-аар эрхтэй хэрэглэгчид. EXIF устгасан, 2048px webp.
model VisitPhoto {
  id            String    @id @default(cuid())
  customerId    String
  appointmentId String?
  visitId       String?
  kind          PhotoKind
  /// Хувийн хавтас дахь түлхүүр (visit-photos/2026/12/<uuid>.webp)
  storageKey    String    @unique
  width         Int
  height        Int
  bytes         Int
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  visit       Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("VisitPhotoCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([appointmentId])
  @@index([visitId])
}

model Visit {
  id             String      @id @default(cuid())
  branchId       String
  customerId     String
  /// Оношлогоо хийсэн хүн
  conductedById  String
  appointmentId  String?     @unique
  /// Борлуулалтгүй айлчлал (зөвхөн зөвлөгөө) байж болно
  saleId         String?     @unique
  skinType       SkinType?
  /// CONCERN collection slug-ууд
  concerns       String[]
  diagnosisNotes String?
  emailStatus    EmailStatus @default(NOT_SENT)
  emailSentAt    DateTime?
  emailError     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conductedBy     User                  @relation(fields: [conductedById], references: [id], onDelete: Restrict)
  appointment     Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  sale            Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  recommendations VisitRecommendation[]
  customerNotes   CustomerNote[]
  photos          VisitPhoto[]

  @@index([customerId, createdAt])
  @@index([branchId, createdAt])
}

model VisitRecommendation {
  id           String   @id @default(cuid())
  visitId      String
  variantId    String
  /// Заавал биш — product.howToUse-ээс урьдчилан бөглөгдөнө
  instructions String?
  purchased    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([visitId])
}

// ─────────────────────────── Борлуулалт ───────────────────────────

/// Борлуулалт. Төлөгдсөнийг устгахгүй, засахгүй — зөвхөн буцаалт (Refund).
/// Төлөвийн машин: src/server/modules/sales/state.ts
model Sale {
  id                   String             @id @default(cuid())
  branchId             String
  /// "CL-20261201-0001" — PENDING_PAYMENT болох үед олгоно (DRAFT-д null)
  number               String?            @unique
  channel              SaleChannel        @default(POS)
  customerId           String?
  appointmentId        String?
  createdById          String
  closedById           String?
  status               SaleStatus         @default(DRAFT)
  receiptStatus        ReceiptStatus      @default(NOT_ISSUED)
  subtotal             Int                @default(0)
  lineDiscountTotal    Int                @default(0)
  saleDiscount         Int                @default(0)
  saleDiscountReason   String?
  /// Хязгаараас хэтэрсэн хөнгөлөлтийг баталсан ADMIN
  discountApprovedById String?
  total                Int                @default(0)
  vatTotal             Int                @default(0)
  paidAmount           Int                @default(0)
  refundedAmount       Int                @default(0)
  note                 String?
  /// POS-ийн хадгалагдаагүй сагс (DRAFT үед): мөр, үйлчлүүлэгч, хөнгөлөлт, оношлогооны ноорог.
  /// Үнэ нь зөвхөн харуулах — checkout үед серверт дахин тооцно. Lock хийхэд null болно.
  draftData            Json?
  /// PENDING_PAYMENT болсон мөч — үүнээс хойш мөр өөрчлөхгүй
  lockedAt             DateTime?
  paidAt               DateTime?
  cancelledAt          DateTime?
  /// Optimistic lock
  version              Int                @default(0)
  // Онлайн захиалга (ирээдүй)
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  shippingAddress      Json?
  fulfillment          FulfillmentStatus?
  expiresAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointment        Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy          User            @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy           User?           @relation("SaleClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  discountApprovedBy User?           @relation("SaleDiscountApprovedBy", fields: [discountApprovedById], references: [id], onDelete: SetNull)
  items              SaleItem[]
  payments           Payment[]
  refunds            Refund[]
  stockMovements     StockMovement[]
  walletTxns         WalletTxn[]
  visit              Visit?
  ebarimt            EbarimtReceipt?

  @@index([branchId, status, createdAt])
  /// Тайлан: төлөгдсөн огноогоор (reports)
  @@index([branchId, status, paidAt])
  @@index([customerId])
  @@index([status, lockedAt])
  @@index([createdById, status, updatedAt])
}

model SaleItem {
  id                    String   @id @default(cuid())
  saleId                String
  kind                  ItemKind
  variantId             String?
  serviceId             String?
  /// Үйлчилгээ хийсэн ажилтан — SERVICE мөрөнд заавал
  staffId               String?
  /// Бүтээгдэхүүнийг зарсан ажилтан (PRODUCT): POS-д анхдагч = цагийн гоо сайханч, эсвэл кассчин
  sellerId              String?
  /// PROMPT 27: багц худалдсан мөр (kind = SERVICE, serviceId = багцын эхний үйлчилгээ). Орлого — ашиглах үед танигдана
  packageTemplateId     String?
  nameSnapshot          String
  skuSnapshot           String?
  unitPrice             Int
  /// PRODUCT: хувилбарын өртөг; SERVICE: орцын өртгийн нийлбэр (ашгийн тайланд)
  unitCostSnapshot      Int      @default(0)
  qty                   Int      @default(1)
  lineDiscount          Int      @default(0)
  lineDiscountReason    String?
  /// Борлуулалтын хөнгөлөлтөөс ногдох хэсэг
  allocatedSaleDiscount Int      @default(0)
  /// unitPrice*qty − lineDiscount − allocatedSaleDiscount
  lineTotal             Int      @default(0)
  vatAmount             Int      @default(0)
  refundedQty           Int      @default(0)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())

  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant          Variant?          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff            User?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  seller           User?             @relation("SaleItemSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  packageTemplate  PackageTemplate?  @relation(fields: [packageTemplateId], references: [id], onDelete: Restrict)
  customerPackages CustomerPackage[]

  @@index([saleId])
  @@index([serviceId])
  @@index([variantId])
  @@index([staffId])
  @@index([sellerId])
}

model Payment {
  id             String    @id @default(cuid())
  saleId         String
  method         PayMethod
  amount         Int
  status         PayStatus @default(PENDING)
  /// Client үүсгэнэ (төлбөрийн оролдлого бүрт) — давхар дарахаас хамгаална
  idempotencyKey String    @unique
  /// Бэлэн: өгсөн мөнгө, хариулт
  tendered       Int?
  change         Int?
  /// Карт: терминалын баримтаас
  cardLast4      String?
  approvalCode   String?
  /// Данс / QPay гараар: гүйлгээний утга, дугаар
  externalRef    String?
  /// Дүн зөрсөн г.м. — админ шалгах шаардлагатай
  reviewReason   String?
  createdById    String
  confirmedById  String?
  cashShiftId    String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sale          Sale                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy     User                 @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy   User?                @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  cashShift     CashShift?           @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  transactions  PaymentTransaction[]
  cashMovements CashMovement[]

  @@index([saleId])
  @@index([status, method, createdAt])
  @@index([cashShiftId])
}

/// Гадны системийн гүйлгээ (QPay invoice). Нэг Payment-д олон оролдлого байж болно.
model PaymentTransaction {
  id                String    @id @default(cuid())
  paymentId         String
  provider          String
  providerInvoiceId String    @unique
  providerPaymentId String?
  providerStatus    String
  qrText            String?
  qrImage           String?
  deeplinks         Json?
  expiresAt         DateTime
  raw               Json
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

model Refund {
  id            String       @id @default(cuid())
  saleId        String
  amount        Int
  reason        String
  status        RefundStatus @default(REQUESTED)
  method        PayMethod
  /// [{ saleItemId, qty, amount }]
  items         Json
  /// Савлагаа нээгдээгүй — үлдэгдэлд буцаасан эсэх
  restock       Boolean      @default(false)
  requestedById String
  approvedById  String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  requestedBy   User           @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy    User?          @relation("RefundApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  cashMovements CashMovement[]

  @@index([saleId])
  @@index([status])
}

// ─────────────────────── eBarimt, Outbox ───────────────────────

model EbarimtReceipt {
  id          String      @id @default(cuid())
  saleId      String      @unique
  type        EbarimtType @default(B2C_RECEIPT)
  customerTin String?
  ddtd        String?     @unique
  lottery     String?
  qrData      String?
  request     Json?
  response    Json?
  status      JobStatus   @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([status])
}

model OutboxJob {
  id        String    @id @default(cuid())
  type      JobType
  /// Давхар ажил үүсгэхгүй: "visit-email:<visitId>"
  dedupeKey String?   @unique
  payload   Json
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAfter  DateTime  @default(now())
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([type, status])
}

// ─────────────────────── Бэлгийн карт, хэтэвч ───────────────────────

model GiftCard {
  id            String    @id @default(cuid())
  code          String    @unique
  initialAmount Int
  expiresAt     DateTime?
  customerId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  wallet   Wallet?
}

/// Үйлчлүүлэгчийн membership хэтэвч ЭСВЭЛ бэлгийн картын үлдэгдэл.
model Wallet {
  id         String   @id @default(cuid())
  customerId String?  @unique
  giftCardId String?  @unique
  /// КЭШ: sum(WalletTxn.amount)
  balance    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  giftCard GiftCard?   @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  txns     WalletTxn[]
}

model WalletTxn {
  id        String   @id @default(cuid())
  walletId  String
  amount    Int
  saleId    String?
  note      String?
  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  sale   Sale?  @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([saleId])
}

// ─────────────────────────── Касс ───────────────────────────

/// Кассын ээлж. Нэг салбарт нэг л OPEN ээлж (partial unique index — migration SQL).
model CashShift {
  id           String          @id @default(cuid())
  branchId     String
  status       CashShiftStatus @default(OPEN)
  openedById   String
  openedAt     DateTime        @default(now())
  openingCash  Int
  closedById   String?
  closedAt     DateTime?
  /// openingCash + Σ CashMovement (хаах үед)
  expectedCash Int?
  countedCash  Int?
  /// countedCash − expectedCash
  difference   Int?
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedBy  User           @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy  User?          @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  payments  Payment[]
  movements CashMovement[]

  @@index([branchId, openedAt])
}

model CashMovement {
  id          String       @id @default(cuid())
  shiftId     String
  type        CashMoveType
  /// +орлого / −зарлага
  amount      Int
  paymentId   String?
  refundId    String?
  note        String?
  createdById String
  createdAt   DateTime     @default(now())

  shift     CashShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund    Refund?   @relation(fields: [refundId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt])
}

model Branch {
  id         String   @id @default(cuid())
  /// Борлуулалтын дугаарын угтвар: "CL"
  code       String   @unique
  /// Имэйл, баримт дээр харагдах салоны нэр
  name       String
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  /// Ирцийн байршил (PROMPT 19): салоны цэг, зөвшөөрөх радиус (м), салоны Wi-Fi-ийн гадаад IP (сонголттой)
  latitude   Float?
  longitude  Float?
  geoRadiusM Int      @default(100)
  allowedIps String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attendanceEvents AttendanceEvent[]
  sales            Sale[]
  shifts           CashShift[]
  visits           Visit[]
  appointments     Appointment[]
  stockMovements   StockMovement[]
  counters         SaleCounter[]
  rooms            Room[]
}

/// Өдөр тутмын борлуулалтын дугаар (УБ цагаар). INSERT … ON CONFLICT DO UPDATE.
model SaleCounter {
  branchId   String
  date       DateTime @db.Date
  lastNumber Int      @default(0)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([branchId, date])
}

// ─────────────────────── Урамшуулал, цалин ───────────────────────

/// Хамгийн тодорхой (specific) дүрэм давуу эрхтэй: staff+item > item > collection > staff > бүгд.
model CommissionRule {
  id           String         @id @default(cuid())
  /// null = бүх ажилтан
  staffId      String?
  serviceId    String?
  collectionId String?
  productId    String?
  kind         ItemKind
  type         CommissionType
  /// PERCENT бол basis point (1000 = 10%), FIXED бол төгрөг / ширхэг
  value        Int
  priority     Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  staff      User?       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service    Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([kind, isActive])
  @@index([staffId])
}

model PayrollPeriod {
  id           String        @id @default(cuid())
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  status       PayrollStatus @default(DRAFT)
  kind         PayrollKind   @default(FULL)
  /// Сүүлд тооцоолсон мөч (null = хараахан тооцоолоогүй)
  calculatedAt DateTime?
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  approvedBy  User?               @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines       PayrollLine[]
  adjustments PayrollAdjustment[]
  expenses    Expense[]

  @@unique([startDate, endDate])
}

model PayrollLine {
  id                String   @id @default(cuid())
  periodId          String
  staffId           String
  baseSalary        Int
  serviceCommission Int      @default(0)
  productCommission Int      @default(0)
  adjustments       Int      @default(0)
  deductions        Int      @default(0)
  /// Төлөвлөсөн / ажилласан өдөр (хагас өдөр = 0.5)
  plannedDays       Float    @default(0)
  workedDays        Float    @default(0)
  gross             Int      @default(0)
  /// НДШ (даатгуулагч), ХХОАТ, ажил олгогчийн НДШ (зардал)
  siEmployee        Int      @default(0)
  pit               Int      @default(0)
  siEmployer        Int      @default(0)
  /// FINAL: хасагдсан урьдчилгаа (гарт олгосон)
  advancePaid       Int      @default(0)
  net               Int
  details           Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  staff  User          @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([periodId, staffId])
}

/// Цалингийн нэмэлт / хасалт (гараар, тайлбартай). Үе+ажилтанд холбоно — дахин тооцоолоход хадгалагдана.
model PayrollAdjustment {
  id          String                @id @default(cuid())
  periodId    String
  staffId     String
  type        PayrollAdjustmentType
  amount      Int
  reason      String
  createdById String?
  createdAt   DateTime              @default(now())

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  staff  User          @relation("PayrollAdjustmentStaff", fields: [staffId], references: [id], onDelete: Restrict)

  @@index([periodId, staffId])
}

/// Ирц — зөвхөн менежер өөрчилсөн өдөр мөр үүснэ
model WorkDay {
  id         String        @id @default(cuid())
  staffId    String
  date       DateTime      @db.Date
  status     WorkDayStatus
  hours      Float?
  note       String?
  /// true = "Ирлээ/Явлаа"-аас автоматаар (PROMPT 19); менежер гараар засвал false (давуу эрхтэй)
  fromEvents Boolean       @default(false)
  markedById String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  staff    User  @relation("WorkDayStaff", fields: [staffId], references: [id], onDelete: Cascade)
  markedBy User? @relation("WorkDayMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([staffId, date])
  @@index([date])
}

/// Нийтийн амралтын өдөр — ажлын өдрийн тоонд орохгүй
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

/// Сарын үндсэн цалингийн түүх — үеийн дундуур өөрчлөгдвөл өдрөөр хуваана
model SalaryHistory {
  id            String   @id @default(cuid())
  staffId       String
  monthly       Int
  effectiveFrom DateTime @db.Date
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  staff User @relation("SalaryHistoryStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, effectiveFrom])
}

/// НДШ / ХХОАТ-ын хувь хэмжээ — огноотой. Хувь нь basis point (1150 = 11.5%).
/// Seed-д албан ёсны утга оруулахгүй: нягтлан оруулж баталгаажуулна (confirmedAt).
model PayrollRateSet {
  id            String    @id @default(cuid())
  effectiveFrom DateTime  @unique @db.Date
  /// Даатгуулагчийн НДШ (bp)
  employeeSiBp  Int       @default(0)
  /// Ажил олгогчийн НДШ ангиллаар: [{ code, label, bp }]
  employerRates Json      @default("[]")
  /// Задаргаа (сонголтоор): [{ label, employeeBp, employerBp }]
  siBreakdown   Json      @default("[]")
  /// НДШ ногдуулах сарын орлогын дээд хязгаар (₮); null = хязгааргүй
  siCap         Int?
  /// ХХОАТ (bp)
  pitBp         Int       @default(0)
  /// Хөнгөлөлтийн шатлал: [{ from, to (null = дээд хязгааргүй), credit }] — сарын ₮
  pitCredits    Json      @default("[]")
  note          String?
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  confirmedBy User? @relation("RateSetConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
}

/// Нэг удаагийн код (WeSend verify эсвэл dev-ийн локал код). target-ийг хэш хэлбэрээр л хадгална (rate limit, хайлт).
model Verification {
  id         String         @id @default(cuid())
  purpose    VerifyPurpose
  channel    MessageChannel
  /// HMAC(normalized утас/имэйл) — нээлттэй утгыг хадгалахгүй
  targetHash String
  /// Дэлгэцэнд: 99****33 / a***@x.mn
  targetMask String
  /// WeSend verify id; локал горимд null
  providerId String?
  /// Локал (dev/test) горимд кодын хэш
  codeHash   String?
  attempts   Int            @default(0)
  status     VerifyStatus   @default(PENDING)
  userId     String?
  customerId String?
  ipHash     String?
  expiresAt  DateTime
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([targetHash, createdAt])
  @@index([ipHash, createdAt])
}

/// Үйлчлүүлэгчийн сайтын session (ажилтны session-оос тусдаа cookie). Токены хэшийг л хадгална.
model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// Илгээсэн SMS / имэйл / код — Тохиргоо → Мэдэгдэл дэх "сүүлийн илгээлтүүд". Хүлээн авагчийг маскалж хадгална.
model MessageLog {
  id         String         @id @default(cuid())
  channel    MessageChannel
  kind       String
  toMask     String
  providerId String?
  status     MessageStatus  @default(QUEUED)
  error      String?
  sandbox    Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([createdAt])
}

/// Үйлчлүүлэгчид илгээсэн айлчлалын тайлан (имэйл) — дэлгэрэнгүйд түүх
model CustomerEmail {
  id         String        @id @default(cuid())
  customerId String
  visitId    String?
  kind       String
  status     MessageStatus @default(QUEUED)
  sentById   String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

// ─────────────────────── Аудит, тохиргоо ───────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

/// Сайтын контент (announcement, hero, promo блокууд гэх мэт). Админ засна.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Нэвтрэх оролдлого — rate limit (IP болон имэйлээр, 15 минутад 5 удаа).
/// key: "ip:1.2.3.4" | "email:a@b.mn"
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Background worker-ийн амьд эсэх (хянах самбарт "сүүлд ажилласан")
model WorkerHeartbeat {
  /// "outbox" г.м. worker-ийн нэр
  id        String   @id
  lastRunAt DateTime
  info      Json?
  updatedAt DateTime @updatedAt
}

/// Сайтаас ирсэн "Салонд захиалах" нөөцлүүлэх хүсэлт. Үлдэгдэл түгжихгүй — ресепшн холбогдоно.
model ProductInquiry {
  id          String        @id @default(cuid())
  name        String
  /// 8 оронтой Монгол дугаар (хэвийн болгосон)
  phone       String
  /// [{ variantId, productName, size, qty, price }]
  items       Json
  note        String?
  status      InquiryStatus @default(NEW)
  /// Spam хамгаалалт (10 минутад 3)
  ip          String?
  handledById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  handledBy User? @relation("InquiryHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

/// Нягтланд илгээсэн өдрийн тайлан (A11): нэг мөр = нэг илгээлт (дахин илгээвэл шинэ мөр)
model ReportDispatch {
  id         String         @id @default(cuid())
  /// УБ өдөр "YYYY-MM-DD"
  day        String
  recipients String[]
  status     DispatchStatus @default(PENDING)
  sentById   String?
  /// Илгээх үеийн дүн (түүхэнд харуулах)
  summary    Json
  error      String?
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  sentBy User? @relation("ReportDispatchSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([day, createdAt])
}

// ─────────────────────── Санхүү (PROMPT 18) ───────────────────────

enum ExpenseKind {
  UTILITY
  INTERNET
  OTHER
  /// Системийн (цалингаас автоматаар) — гараар бүртгэхгүй
  PAYROLL
  SOCIAL_INSURANCE
  PIT
}

/// Зардлын ангилал. code — нягтлангийн данс/код (TODO: нягтлан баталгаажуулна).
model ExpenseCategory {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  kind      ExpenseKind
  /// PAYROLL / SOCIAL_INSURANCE / PIT — цалин батлагдахад автоматаар, гараар засахгүй
  isSystem  Boolean     @default(false)
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  expenses Expense[]
}

/// Зардал (Clessiin зарлага). amount — НӨАТ-тэй нийт дүн (₮), vatAmount — vatOf()-оор.
model Expense {
  id              String     @id @default(cuid())
  categoryId      String
  date            DateTime   @db.Date
  amount          Int
  vatIncluded     Boolean    @default(false)
  vatAmount       Int        @default(0)
  /// Төлбөрийн код: хэрэглэгчийн код / гэрээний № / нэхэмжлэхийн № (ашиглалт, интернэтэд заавал)
  reference       String?
  vendor          String?
  note            String?
  /// Бэлэн (CASH) / данс (TRANSFER, CARD, QPAY); системийн мөрөнд null
  paidVia         PayMethod?
  /// Хувийн storage-ийн түлхүүр (зураг/PDF) — нийтэд биш
  receiptPath     String?
  /// Системийн мөр (цалингийн үе)
  payrollPeriodId String?
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payrollPeriod PayrollPeriod?  @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  createdBy     User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([payrollPeriodId, categoryId])
  @@index([date])
  @@index([categoryId, date])
}

// ─────────────────────── Байршлаар ирц (PROMPT 19) ───────────────────────

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceSource {
  GEO
  MANAGER
  AUTO_CLOSE
}

/// "Ирлээ / Явлаа". at — серверийн цаг (утасны цагт итгэхгүй). lat/lng — 90 хоногийн дараа null болно.
model AttendanceEvent {
  id          String              @id @default(cuid())
  staffId     String
  branchId    String
  type        AttendanceEventType
  at          DateTime            @default(now())
  lat         Float?
  lng         Float?
  accuracyM   Float?
  distanceM   Float?
  ipHash      String?
  source      AttendanceSource
  /// Сэжигтэй: нарийвчлал муу, IP таарахгүй, "Явлаа" дараагүй (AUTO_CLOSE)
  flagged     Boolean             @default(false)
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())

  staff     User   @relation("AttendanceEventStaff", fields: [staffId], references: [id], onDelete: Cascade)
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("AttendanceEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([staffId, at])
  @@index([at])
}

/// Ирцийн тайлбар (PROMPT 20) — менежер / админ бичнэ, цагт НӨЛӨӨЛӨХГҮЙ (жишээ: "Явлаа дараагүй — 19:30-д явсан")
model AttendanceNote {
  id          String   @id @default(cuid())
  staffId     String
  date        DateTime @db.Date
  note        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff     User  @relation("AttendanceNoteStaff", fields: [staffId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AttendanceNoteBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([staffId, date])
}

// ─────────────────────── Багц үйлчилгээ (PROMPT 27 §4, docs/plan-packages.md) ───────────────────────

enum CustomerPackageStatus {
  ACTIVE
  USED_UP
  EXPIRED
  REFUNDED
}

/// Багцын загвар (ACCOUNTANT/ADMIN): "Нүүрний эмчилгээ 10+1" — төлөх 10 + бонус 1 = 11 удаа
model PackageTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  paidSessions  Int
  bonusSessions Int      @default(0)
  /// Багцын үнэ (₮, НӨАТ-тэй). Анхдагч = үйлчилгээний үнэ × төлөх тоо (засаж болно)
  price         Int
  /// Худалдсанаас хойш хүчинтэй хоног (null = хугацаагүй)
  validDays     Int?
  isActive      Boolean  @default(true)
  /// Сайтын /services дээр харагдах
  isPublic      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services         PackageTemplateService[]
  customerPackages CustomerPackage[]
  saleItems        SaleItem[]
}

model PackageTemplateService {
  packageId String
  serviceId String

  package PackageTemplate @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
}

/// Үйлчлүүлэгчийн худалдаж авсан багц. usedSessions — КЭШ: Σ буцаагдаагүй PackageRedemption
model CustomerPackage {
  id            String                @id @default(cuid())
  customerId    String
  templateId    String
  /// Худалдсан POS мөр (бүтэн төлөгдөхөд үүснэ — нэг мөрт нэг)
  saleItemId    String?               @unique
  name          String
  /// Ашиглаж болох үйлчилгээ (худалдах үеийн snapshot)
  serviceIds    String[]
  totalSessions Int
  usedSessions  Int                   @default(0)
  /// Бодит төлсөн дүн (хөнгөлөлтийн дараа)
  paidAmount    Int
  purchasedAt   DateTime              @default(now())
  expiresAt     DateTime?
  status        CustomerPackageStatus @default(ACTIVE)
  /// Буцаалт (ADMIN): буцаасан дүн, торгууль
  refundAmount  Int?
  refundPenalty Int?
  refundedAt    DateTime?
  /// Хугацаа дуусахын сануулга илгээсэн
  remindedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  template     PackageTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  saleItem     SaleItem?           @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  redemptions  PackageRedemption[]
  appointments Appointment[]

  @@index([customerId, status])
  @@index([status, expiresAt])
}

/// Нэг удаагийн ашиглалт. unitValue = төлсөн ÷ нийт удаа (сүүлийн удаа үлдэгдлийг авна). Нэг цагт нэг.
model PackageRedemption {
  id                String    @id @default(cuid())
  customerPackageId String
  appointmentId     String?   @unique
  serviceId         String
  staffId           String?
  unitValue         Int
  reversedAt        DateTime?
  reverseReason     String?
  createdById       String?
  createdAt         DateTime  @default(now())

  customerPackage CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Restrict)
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff           User?           @relation("PackageRedemptionStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([customerPackageId])
  @@index([createdAt])
}
