{
  "name": "cless",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 20267",
    "dev:all": "bun scripts/dev-all.ts",
    "prebuild": "bun scripts/check-db-url.ts",
    "build": "next build",
    "start": "next start --port 20267",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "bun --preload ./src/worker/preload.ts src/worker/index.ts",
    "preflight": "bun --preload ./src/worker/preload.ts scripts/preflight.ts",
    "images:build": "bun scripts/build-default-images.ts",
    "images:attach": "bun --preload ./src/worker/preload.ts scripts/attach-default-images.ts",
    "seed:demo-sales": "bun --preload ./src/worker/preload.ts scripts/seed-demo-sales.ts",
    "admin:create": "bun scripts/create-admin.ts",
    "worker:build": "bun scripts/build-worker.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "bcryptjs": "^3.0.3",
    "exceljs": "4.4.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bun": "latest",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.3.11",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
