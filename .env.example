# Апп ажиллах үеийн холболт.
# Supabase: Transaction pooler (порт 6543) + ?pgbouncer=true. Локал: postgresql://postgres:postgres@localhost:5432/biologique
# Vercel-ийн самбарт ХАШИЛТГҮЙ, "DATABASE_URL=" угтваргүй, зай/шинэ мөргүй оруулна (`bun run build`-ийн
# өмнө scripts/check-db-url.ts шалгана). Нууц үгийн @ : / ? # % тэмдэгтийг percent-encode хийнэ.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cless_local"

# Migration-д ашиглах шууд холболт (Supabase: Session pooler эсвэл Direct, порт 5432).
# Локал Postgres дээр DATABASE_URL-тэй ижил байж болно.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/cless_local"

# Seed-ийн ADMIN хэрэглэгчийн түр нууц үг (admin@example.mn)
SEED_ADMIN_PASSWORD="change-me-please"

# Auth.js session шифрлэх түлхүүр. Үүсгэх: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"
# Vercel-ээс өөр газар (өөрийн сервер) байршуулахад
# AUTH_TRUST_HOST=true

# Canonical, og:image, JSON-LD-ийн бүрэн URL-ууд үүнээс үүснэ (төгсгөлийн "/"-гүй).
# Production: https://your-domain.mn
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:20267"

# ─── QPay Merchant API v2 (заавал биш) ───
# Бүгд тохируулагдаж, админы тохиргоо qpay.mode = "api" үед л API горим.
# Байхгүй бол "гараар" горим: терминалаар төлүүлээд гүйлгээний дугаарыг оруулна.
# Sandbox: https://merchant-sandbox.qpay.mn · Production: https://merchant.qpay.mn
QPAY_BASE_URL=
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# VERIFY: QPay-ээс тодруулах (байхгүй бол "terminal")
QPAY_INVOICE_RECEIVER_CODE=
# Callback URL-ийн HMAC түлхүүр. Үүсгэх: openssl rand -hex 32
QPAY_CALLBACK_SECRET=

# ─── Имэйл (Resend) ───
# Байхгүй бол имэйлийг .emails/<id>.html файл руу бичнэ (dev).
RESEND_API_KEY=
# Баталгаажсан домэйнээс: "CLÉSS <no-reply@your-domain.mn>"
EMAIL_FROM=

# ─── Worker → app кэш шинэчлэх (заавал: production) ───
# Worker үлдэгдэл өөрчлөхөд (QPay төлбөр, удаан түгжээ тайлах) сайтын кэшийг шинэчилнэ.
# Үүсгэх: openssl rand -hex 32  (32+ тэмдэгт; app ба worker-т ИЖИЛ утга)
INTERNAL_REVALIDATE_SECRET=
# Worker-ээс app руу дотоод хаяг (reverse proxy-гүй). Docker: http://app:20267
APP_INTERNAL_URL=http://127.0.0.1:20267

# ─── Pool (заавал биш) ───
# Нэг процесс/serverless instance-ийн pg холболтын дээд тоо. Default: Vercel дээр 3, бусад газар 10.
# DB_POOL_MAX=3

# ─── Бусад ───
# LOG_LEVEL=debug        # debug лог (default: info)
# ENV_CHECK=relaxed      # ЗӨВХӨН локалд production build-ийг http-ээр турших (E2E); production-д БҮҮ тавь
